# Copy to .env.local and fill in what you have. Every one of these is optional:
# with none of them set, the terminal runs on the offline oracle and seeded
# demo wallets, which is a complete experience -- just a less surprising one.

# Enables the AI oracle. Without it, /api/prophecy returns 503 and the client
# falls back to the local composer.
# https://console.anthropic.com
ANTHROPIC_API_KEY=

# Enables real wallet lookups instead of seeded demo histories.
# https://etherscan.io/apis
ETHERSCAN_API_KEY=
